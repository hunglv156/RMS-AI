# Sao chép thành .env. Các giá trị dưới đây chỉ dùng cho môi trường local.
# Dùng cổng 5xxxx để không đụng project khác (hot-updater đang giữ 5432, 9000, 9001).

# PostgreSQL
POSTGRES_DB=rms
POSTGRES_USER=rms_admin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432

# Redis
REDIS_PORT=56379

# Object storage tương thích S3 (RustFS)
S3_ACCESS_KEY=rms_s3_local
S3_SECRET_KEY=change-me-local-only
S3_PORT=59000
S3_CONSOLE_PORT=59001
S3_BUCKET=rms-resumes
