# Sao chép thành .env. Các giá trị dưới đây chỉ dùng cho môi trường local.
# Dùng cổng 5xxxx để không đụng project khác (hot-updater đang giữ 5432, 9000, 9001).

# PostgreSQL
POSTGRES_DB=rms
POSTGRES_USER=rms_admin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432

# Redis
REDIS_PORT=56379

# Object storage tương thích S3 (RustFS)
S3_ACCESS_KEY=rms_s3_local
S3_SECRET_KEY=change-me-local-only
S3_PORT=59000
S3_CONSOLE_PORT=59001
S3_BUCKET=rms-resumes

# API (NestJS)
API_PORT=3000
DATABASE_URL=postgres://rms_app:rms_app_local@127.0.0.1:55432/rms
DATABASE_URL_ADMIN=postgres://rms_admin:change-me-local-only@127.0.0.1:55432/rms
JWT_SECRET=change-me-local-only-at-least-32-chars
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000

# AI service (FastAPI) và chữ ký HMAC nội bộ
AI_SERVICE_URL=http://127.0.0.1:8000
AI_HMAC_SECRET=change-me-local-only-at-least-32-chars
AI_DATABASE_URL=postgres://rms_ai:rms_ai_local@127.0.0.1:55432/rms
OLLAMA_URL=http://127.0.0.1:11434
