{
  "name": "rms-ai",
  "version": "0.0.0",
  "private": true,
  "description": "AI-assisted recruitment management system (master's thesis)",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:reset": "docker compose down -v",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm infra:up && pnpm --parallel --filter @rms/api --filter @rms/web dev",
    "db:migrate": "pnpm --filter @rms/api exec tsx src/db/migrate-cli.ts up",
    "db:rollback": "pnpm --filter @rms/api exec tsx src/db/migrate-cli.ts down",
    "test:e2e": "pnpm --filter @rms/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
