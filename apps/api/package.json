{
  "name": "@rms-ai/api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx test/run.ts unit",
    "test:integration": "tsx test/run.ts integration",
    "check": "pnpm typecheck && pnpm test:unit && pnpm build",
    "db:migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "db:seed": "tsx src/db/seeds/run.ts",
    "dev": "tsx watch src/main.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "start": "node dist/src/main.js",
    "worker:start": "node dist/src/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.11",
    "@nestjs/core": "11.1.11",
    "@nestjs/platform-express": "11.1.11",
    "@rms-ai/contracts": "workspace:*",
    "argon2": "0.44.0",
    "bullmq": "5.66.5",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "ioredis": "5.9.2",
    "knex": "3.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.11",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "26.0.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3"
  }
}
